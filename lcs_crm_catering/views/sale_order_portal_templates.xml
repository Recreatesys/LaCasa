<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Customer portal: show the LCS quotation, not Odoo's default  -->
    <!--                                                              -->
    <!-- C19 (client comment, slide 19): Print produced the LCS       -->
    <!-- layout while Preview showed the stock Odoo order page, so    -->
    <!-- the customer saw two different documents for one quotation.  -->
    <!-- Both now render lcs_crm_catering.report_quotation_lcs_body.  -->
    <!--                                                              -->
    <!-- Only the informations block and the line table are replaced. -->
    <!-- The accept / signature and payment sections in this template -->
    <!-- are deliberately left intact — replacing the whole thing     -->
    <!-- would take away the customer's ability to accept the         -->
    <!-- quotation.                                                   -->
    <!-- ============================================================ -->
    <template id="sale_order_portal_content_lcs"
              inherit_id="sale.sale_order_portal_content">

        <!-- Odoo's own header block duplicates what the LCS layout prints. -->
        <xpath expr="//div[@id='informations']" position="replace"/>

        <xpath expr="//section[@id='details']" position="replace">
            <section id="details" style="page-break-inside: auto;">
                <t t-set="o" t-value="sale_order"/>
                <!-- The PDF embeds the logo as a data URI via image_data_uri,
                     which is a report-rendering helper. On a web page a plain
                     /web/image URL is the equivalent. -->
                <t t-set="lcs_logo_src"
                   t-value="'/web/image/res.company/%s/logo' % sale_order.company_id.id"/>
                <t t-call="lcs_crm_catering.report_quotation_lcs_body"/>

                <!-- sale_management's SaleUpdateLineButton interaction binds
                     to .o_portal_sale_sidebar, which is still on the page,
                     and its setup() then does an unguarded

                         this.el.querySelector("table#sales_order_table").dataset

                     Replacing Odoo's line table left that null and threw
                     "Cannot read properties of null (reading 'dataset')" on
                     every portal view. Keep the element the interaction
                     expects, carrying the two data attributes it reads.
                     Hidden and empty: LCS quotations have no editable
                     quantities or optional products, so the interaction's own
                     handlers (a.js_update_line_json, .js_quantity) match
                     nothing and it stays inert. -->
                <table id="sales_order_table" class="d-none"
                       t-att-data-order-id="sale_order.id"
                       t-att-data-token="sale_order.access_token"/>
            </section>
        </xpath>

        <!-- Odoo's totals table (div#total) sits INSIDE section#details, so
             replacing details above already removed it; the LCS body prints
             its own total. The accept/signature section is a sibling of
             details, not a child, so it survives untouched. -->

    </template>

</odoo>
