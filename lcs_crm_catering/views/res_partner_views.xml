<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_inherit_lcs" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.lcs</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="shortname"/>
                <!-- C01 (client comment, slide 1): set the client type here,
                     when the customer is created, instead of being asked for
                     it again on every opportunity. -->
                <field name="client_type"/>
            </xpath>
        </field>
    </record>

</odoo>
