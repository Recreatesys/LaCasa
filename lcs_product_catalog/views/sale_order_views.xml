<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_view_form_inherit_lcs_catalog" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.lcs.catalog</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add a Set / Expand Sets / Reload Sets buttons — placed ABOVE
                 the notebook so they stay visible in both single-day and
                 multi-day layouts (in multi-day the standard Order Lines
                 tab is hidden, replaced by per-day tabs). -->
            <xpath expr="//notebook" position="before">
                <!-- C13 (client comment, slide 13): "Only 2 items chosen but
                     the system doesn't remind me." Live count check;
                     action_confirm blocks on the same breaches. -->
                <div class="alert alert-warning mb-2" role="alert"
                     invisible="not set_selection_warning">
                    <strong>Set selection incomplete</strong>
                    <field name="set_selection_warning" nolabel="1" readonly="1"/>
                </div>
                <div class="mb-2">
                    <button name="action_open_set_picker"
                            string="Add a Set"
                            type="object"
                            class="btn-primary me-2"
                            icon="fa-plus-circle"/>
                    <button name="action_expand_sets"
                            string="Expand Sets"
                            type="object"
                            class="btn-secondary me-2"
                            icon="fa-cutlery"/>
                    <button name="action_reload_sets"
                            string="Reload Sets (Update Guest Count)"
                            type="object"
                            class="btn-link"
                            icon="fa-refresh"
                            confirm="This will recalculate all set lines based on the current guest count. Your dish selections will be preserved. Continue?"/>
                    <!-- C21a: keep this menu for re-use on later quotations. -->
                    <button name="action_open_save_as_set_wizard"
                            string="Save as New Set"
                            type="object"
                            class="btn-link"
                            icon="fa-floppy-o"/>
                    <!-- C08: derive the delivery charge from where the food
                         is going plus how it is delivered. -->
                    <button name="action_open_delivery_zone_wizard"
                            string="Locate Delivery Zone"
                            type="object"
                            class="btn-link"
                            icon="fa-map-marker"
                            invisible="state not in ('draft', 'sent')"/>
                </div>
            </xpath>

            <!-- Add set fields to SO line list -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_id']" position="before">
                <field name="is_set_line" column_invisible="1"/>
                <field name="is_addon_piece" column_invisible="1"/>
                <field name="dish_selected" string="Pick"
                       readonly="not is_set_line"/>
                <field name="set_line_code" string="Code" readonly="1"
                       optional="show"/>
                <field name="set_product_id" column_invisible="1"/>
                <field name="catering_set_id" column_invisible="1"/>
            </xpath>

            <!-- Add set_unit, full_price, per_piece_price after product_uom_qty -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_qty']" position="after">
                <field name="set_unit" string="Unit" readonly="1"
                       optional="show"/>
                <field name="full_price" string="Set Price" readonly="1"
                       optional="show"/>
                <field name="per_piece_price" string="Per pc $" readonly="1"
                       optional="hide"/>
                <!-- C21b (client comment, slide 21): internal cost / margin.
                     optional="hide" by default so the everyday line list stays
                     readable; sales enables the columns when pricing a set. -->
                <field name="lcs_unit_cost" string="Cost / Unit" readonly="1"
                       optional="hide"/>
                <field name="lcs_line_cost" string="Line Cost" readonly="1"
                       optional="hide"/>
                <field name="lcs_margin_pct" string="Margin %" readonly="1"
                       optional="hide"
                       decoration-danger="lcs_margin_pct &lt; 0"/>
            </xpath>

            <!-- Hide Taxes column by default -->
            <xpath expr="//field[@name='order_line']//list//field[@name='tax_ids']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>

            <!-- Hide Discount column by default -->
            <xpath expr="//field[@name='order_line']//list//field[@name='discount']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

</odoo>
