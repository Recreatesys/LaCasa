<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_lcs" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.lcs</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- NB: the sale settings view mixes @id and @name on its
                 blocks; this one is addressed by @name. -->
            <xpath expr="//block[@name='quotation_order_setting_container']" position="after">
                <block title="LCS Catering" name="lcs_catering_settings">
                    <setting id="lcs_margin_approval_setting"
                             string="Require Approval on Low Margin"
                             help="Confirming a quotation that has any priced line below the margin floor needs a Sales Manager. Margin comes from Odoo's Margins feature, so product costs must be filled in for this to mean anything.">
                        <field name="lcs_margin_approval_active"/>
                        <div class="content-group mt-2"
                             invisible="not lcs_margin_approval_active">
                            <div class="row">
                                <label for="lcs_margin_approval_threshold"
                                       string="Minimum line margin"
                                       class="col-lg-4 o_light_label"/>
                                <field name="lcs_margin_approval_threshold"
                                       class="oe_inline"/>
                                <span class="ms-1">%</span>
                            </div>
                        </div>
                    </setting>
                    <setting id="lcs_google_maps_setting"
                             string="Google Maps API Key"
                             help="Lets the delivery-zone lookup geocode an event address and read back its Hong Kong district. Needs the Geocoding API enabled on a billing-enabled Google Cloud project. Without a key the lookup still works, with the district chosen by hand.">
                        <field name="lcs_google_maps_api_key" password="True"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
