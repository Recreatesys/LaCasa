        </record>
        <record id="delivery_district_eastern" model="lcs.delivery.district">
            <field name="name">Eastern</field>
            <field name="name_zh">東區</field>
            <field name="zone_id" ref="delivery_zone_a"/>
            <field name="match_keys">Eastern District,North Point,Quarry Bay,Tai Koo,Taikoo,Sai Wan Ho,Shau Kei Wan,Chai Wan,Heng Fa Chuen,東區,北角,鰂魚涌,太古,西灣河,筲箕灣,柴灣</field>
        </record>
        <record id="delivery_district_southern" model="lcs.delivery.district">
            <field name="name">Southern</field>
            <field name="name_zh">南區</field>
            <field name="zone_id" ref="delivery_zone_a"/>
            <field name="match_keys">Southern District,Aberdeen,Wong Chuk Hang,Repulse Bay,Stanley,Ap Lei Chau,Pok Fu Lam,Cyberport,南區,香港仔,黃竹坑,淺水灣,赤柱,鴨脷洲,薄扶林,數碼港</field>
        </record>

        <!-- ── Zone B — Kowloon + Kwai Tsing ── -->
        <record id="delivery_district_yau_tsim_mong" model="lcs.delivery.district">
            <field name="name">Yau Tsim Mong</field>
            <field name="name_zh">油尖旺區</field>
            <field name="zone_id" ref="delivery_zone_b"/>
            <field name="match_keys">Yau Tsim Mong,Tsim Sha Tsui,Jordan,Yau Ma Tei,Mong Kok,Prince Edward,West Kowloon,油尖旺,尖沙咀,佐敦,油麻地,旺角,太子,西九龍</field>
        </record>
        <record id="delivery_district_sham_shui_po" model="lcs.delivery.district">
            <field name="name">Sham Shui Po</field>
            <field name="name_zh">深水埗區</field>
            <field name="zone_id" ref="delivery_zone_b"/>
            <field name="match_keys">Sham Shui Po,Cheung Sha Wan,Lai Chi Kok,Mei Foo,Shek Kip Mei,深水埗,長沙灣,荔枝角,美孚,石硤尾</field>
        </record>
        <record id="delivery_district_kowloon_city" model="lcs.delivery.district">
            <field name="name">Kowloon City</field>
            <field name="name_zh">九龍城區</field>
            <field name="zone_id" ref="delivery_zone_b"/>
            <field name="match_keys">Kowloon City,Hung Hom,To Kwa Wan,Ho Man Tin,Kowloon Tong,Kai Tak,九龍城,紅磡,土瓜灣,何文田,九龍塘,啟德</field>
        </record>
        <record id="delivery_district_wong_tai_sin" model="lcs.delivery.district">
            <field name="name">Wong Tai Sin</field>
            <field name="name_zh">黃大仙區</field>
            <field name="zone_id" ref="delivery_zone_b"/>
            <field name="match_keys">Wong Tai Sin,Diamond Hill,Choi Hung,San Po Kong,Ngau Chi Wan,黃大仙,鑽石山,彩虹,新蒲崗,牛池灣</field>
        </record>
        <record id="delivery_district_kwun_tong" model="lcs.delivery.district">
            <field name="name">Kwun Tong</field>
            <field name="name_zh">觀塘區</field>
            <field name="zone_id" ref="delivery_zone_b"/>
            <field name="match_keys">Kwun Tong,Ngau Tau Kok,Kowloon Bay,Lam Tin,Yau Tong,Sau Mau Ping,觀塘,牛頭角,九龍灣,藍田,油塘,秀茂坪</field>
        </record>
        <record id="delivery_district_kwai_tsing" model="lcs.delivery.district">
            <field name="name">Kwai Tsing</field>
            <field name="name_zh">葵青區</field>
            <field name="zone_id" ref="delivery_zone_b"/>
            <field name="match_keys">Kwai Tsing,Kwai Chung,Kwai Fong,Tsing Yi,葵青,葵涌,葵芳,青衣</field>
        </record>

        <!-- ── Zone C — the rest of the New Territories ── -->
        <record id="delivery_district_tsuen_wan" model="lcs.delivery.district">
            <field name="name">Tsuen Wan</field>
            <field name="name_zh">荃灣區</field>
            <field name="zone_id" ref="delivery_zone_c"/>
            <field name="match_keys">Tsuen Wan,Ting Kau,Sham Tseng,荃灣,汀九,深井</field>
        </record>
        <record id="delivery_district_tuen_mun" model="lcs.delivery.district">
            <field name="name">Tuen Mun</field>
            <field name="name_zh">屯門區</field>
            <field name="zone_id" ref="delivery_zone_c"/>
            <field name="match_keys">Tuen Mun,So Kwun Wat,屯門,掃管笏</field>
        </record>
        <record id="delivery_district_yuen_long" model="lcs.delivery.district">
