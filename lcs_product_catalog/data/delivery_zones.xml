<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- Delivery zones — C08 (client comment, slide 8)               -->
        <!--                                                              -->
        <!-- noupdate: once live, ops maintain rates and districts in the -->
        <!-- UI (Sales ▸ Configuration ▸ Delivery Zones). A module        -->
        <!-- upgrade must not overwrite their corrections.                -->
        <!-- ============================================================ -->

        <record id="delivery_zone_a" model="lcs.delivery.zone">
            <field name="name">District A (HK Island)</field>
            <field name="code">A</field>
            <field name="sequence">10</field>
        </record>
        <record id="delivery_zone_b" model="lcs.delivery.zone">
            <field name="name">District B (Kowloon / Kwai Tsing)</field>
            <field name="code">B</field>
            <field name="sequence">20</field>
        </record>
        <record id="delivery_zone_c" model="lcs.delivery.zone">
            <field name="name">District C (Other N.T.)</field>
            <field name="code">C</field>
            <field name="sequence">30</field>
        </record>
        <record id="delivery_zone_d" model="lcs.delivery.zone">
            <field name="name">District D (Tung Chung / Discovery Bay)</field>
            <field name="code">D</field>
            <field name="sequence">40</field>
        </record>

        <!-- ── Rates ──
             Only the two delivery types LCS has priced. Simple Set-up
             (Round-trip / One-trip) and Event have no agreed rate yet, so no
             row exists and the wizard says so rather than guessing. Self
             Pick-up is intentionally never charged. -->

        <record id="delivery_rate_a_door" model="lcs.delivery.zone.rate">
            <field name="zone_id" ref="delivery_zone_a"/>
            <field name="delivery_type">drop_off_door</field>
            <field name="product_id" search="[('product_tmpl_id','=',ref('addon_cp_delivery_a_d2d'))]" model="product.product"/>
        </record>
        <record id="delivery_rate_a_pickup" model="lcs.delivery.zone.rate">
            <field name="zone_id" ref="delivery_zone_a"/>
            <field name="delivery_type">drop_off_pickup</field>
            <field name="product_id" search="[('product_tmpl_id','=',ref('addon_cp_delivery_a_pickup'))]" model="product.product"/>
        </record>
        <record id="delivery_rate_b_door" model="lcs.delivery.zone.rate">
            <field name="zone_id" ref="delivery_zone_b"/>
            <field name="delivery_type">drop_off_door</field>
            <field name="product_id" search="[('product_tmpl_id','=',ref('addon_cp_delivery_b_d2d'))]" model="product.product"/>
        </record>
        <record id="delivery_rate_b_pickup" model="lcs.delivery.zone.rate">
            <field name="zone_id" ref="delivery_zone_b"/>
            <field name="delivery_type">drop_off_pickup</field>
            <field name="product_id" search="[('product_tmpl_id','=',ref('addon_cp_delivery_b_pickup'))]" model="product.product"/>
        </record>
        <record id="delivery_rate_c_door" model="lcs.delivery.zone.rate">
            <field name="zone_id" ref="delivery_zone_c"/>
            <field name="delivery_type">drop_off_door</field>
            <field name="product_id" search="[('product_tmpl_id','=',ref('addon_cp_delivery_c_d2d'))]" model="product.product"/>
        </record>
        <record id="delivery_rate_c_pickup" model="lcs.delivery.zone.rate">
            <field name="zone_id" ref="delivery_zone_c"/>
            <field name="delivery_type">drop_off_pickup</field>
            <field name="product_id" search="[('product_tmpl_id','=',ref('addon_cp_delivery_c_pickup'))]" model="product.product"/>
        </record>
        <record id="delivery_rate_d_door" model="lcs.delivery.zone.rate">
            <field name="zone_id" ref="delivery_zone_d"/>
            <field name="delivery_type">drop_off_door</field>
            <field name="product_id" search="[('product_tmpl_id','=',ref('addon_cp_delivery_d_d2d'))]" model="product.product"/>
        </record>
        <record id="delivery_rate_d_pickup" model="lcs.delivery.zone.rate">
            <field name="zone_id" ref="delivery_zone_d"/>
            <field name="delivery_type">drop_off_pickup</field>
            <field name="product_id" search="[('product_tmpl_id','=',ref('addon_cp_delivery_d_pickup'))]" model="product.product"/>
        </record>

        <!-- ── Localities that override their own district ──
             Tung Chung and Discovery Bay sit inside Islands District but are
             priced as zone D. sequence 10 so they are tested before the
             Islands District record below, which would otherwise swallow
             them. -->

        <record id="delivery_district_tung_chung" model="lcs.delivery.district">
            <field name="name">Tung Chung</field>
            <field name="name_zh">東涌</field>
            <field name="zone_id" ref="delivery_zone_d"/>
            <field name="sequence">10</field>
            <field name="match_keys">Tung Chung,Tung Chung New Town,東涌</field>
        </record>
        <record id="delivery_district_discovery_bay" model="lcs.delivery.district">
            <field name="name">Discovery Bay</field>
            <field name="name_zh">愉景灣</field>
            <field name="zone_id" ref="delivery_zone_d"/>
            <field name="sequence">10</field>
            <field name="match_keys">Discovery Bay,DB Plaza,愉景灣</field>
        </record>

        <!-- ── Zone A — Hong Kong Island ── -->
        <record id="delivery_district_central_western" model="lcs.delivery.district">
            <field name="name">Central and Western</field>
            <field name="name_zh">中西區</field>
            <field name="zone_id" ref="delivery_zone_a"/>
            <field name="match_keys">Central and Western,Central &amp; Western,Central,Sheung Wan,Kennedy Town,Sai Ying Pun,Mid-Levels,Admiralty,中環,上環,堅尼地城,西營盤,半山,金鐘</field>
        </record>
        <record id="delivery_district_wan_chai" model="lcs.delivery.district">
            <field name="name">Wan Chai</field>
            <field name="name_zh">灣仔區</field>
            <field name="zone_id" ref="delivery_zone_a"/>
