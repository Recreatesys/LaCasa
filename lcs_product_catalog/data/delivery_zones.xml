        </record>
        <record id="delivery_district_islands" model="lcs.delivery.district">
            <field name="name">Islands District</field>
            <field name="name_zh">離島區</field>
            <field name="zone_id" ref="delivery_zone_c"/>
            <field name="sequence">90</field>
            <field name="match_keys">Islands District,Lantau,Cheung Chau,Lamma,Peng Chau,Mui Wo,Airport,Chek Lap Kok,離島,大嶼山,長洲,南丫島,坪洲,梅窩,機場,赤鱲角</field>
        </record>

    </data>
</odoo>
