        </record>
        <record id="delivery_district_north" model="lcs.delivery.district">
            <field name="name">North District</field>
            <field name="name_zh">北區</field>
            <field name="zone_id" ref="delivery_zone_c"/>
            <field name="match_keys">North District,Sheung Shui,Fanling,Sha Tau Kok,北區,上水,粉嶺,沙頭角</field>
        </record>
        <record id="delivery_district_tai_po" model="lcs.delivery.district">
            <field name="name">Tai Po</field>
            <field name="name_zh">大埔區</field>
            <field name="zone_id" ref="delivery_zone_c"/>
            <field name="match_keys">Tai Po,Tai Wo,Science Park,大埔,太和,科學園</field>
        </record>
        <record id="delivery_district_sha_tin" model="lcs.delivery.district">
            <field name="name">Sha Tin</field>
            <field name="name_zh">沙田區</field>
            <field name="zone_id" ref="delivery_zone_c"/>
            <field name="match_keys">Sha Tin,Shatin,Ma On Shan,Tai Wai,Fo Tan,沙田,馬鞍山,大圍,火炭</field>
        </record>
        <record id="delivery_district_sai_kung" model="lcs.delivery.district">
            <field name="name">Sai Kung</field>
            <field name="name_zh">西貢區</field>
            <field name="zone_id" ref="delivery_zone_c"/>
