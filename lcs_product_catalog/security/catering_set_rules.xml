<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- C21a: a set saved from a quotation is private to whoever saved it
             until a Sales Manager publishes it. The curated LCS menus have no
             owner, so they stay visible to everyone. -->
        <record id="rule_catering_set_own_or_shared" model="ir.rule">
            <field name="name">Catering sets: own, shared, or built-in</field>
            <field name="model_id" ref="model_lcs_catering_set"/>
            <field name="domain_force">
                ['|', '|', ('user_id', '=', False),
                           ('is_shared', '=', True),
                           ('user_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Sales Managers see everything, so they can review and publish. -->
        <record id="rule_catering_set_manager_all" model="ir.rule">
            <field name="name">Catering sets: managers see all</field>
            <field name="model_id" ref="model_lcs_catering_set"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        </record>

    </data>
</odoo>
